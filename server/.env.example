# Copy to server/.env for this computer, or add the same names in Vercel → Settings → Environment Variables.
# Never share or commit the real values.

# --- Database (Supabase → Project → Connect → "Transaction pooler" URI, port 6543) ---
# Leave empty on this computer to use the built-in local database (server/data/pglite).
DATABASE_URL=

# --- Login security: a long random text, at least 32 characters (required on Vercel) ---
APP_SECRET=

# --- First admin (created only when the database has no admin yet) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Public address of the site, used in volunteer WhatsApp task links (e.g. https://ysrcp-nri-wing.vercel.app) ---
SITE_URL=

# --- Supabase Storage for gallery photos (Supabase → Project Settings → API) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email: registration + login codes, Help Desk / task updates, newsletter ---
# EASIEST – Gmail: your Gmail address + a 16-letter Google App password (Google Account → Security → 2-Step Verification → App passwords)
SMTP_USER=
SMTP_PASS=
# optional for other mail servers (default smtp.gmail.com, port 465)
SMTP_HOST=
SMTP_PORT=
# OR Resend (https://resend.com, needs your own domain):
# New members must verify their email with a 6-digit code – registration is paused until one of these is set.
RESEND_API_KEY=
MAIL_FROM=YSRCP NRI Wing <noreply@your-domain.org>
# On this computer only: MAIL_DEV_LOG=1 prints emails (and login codes) in the server window instead of sending them
MAIL_DEV_LOG=

# --- Daily gallery check on Vercel (any long random text; Vercel sends it to /api/cron/gallery) ---
CRON_SECRET=

# --- Auto-gallery: the wing's Facebook Page / Instagram (see README) ---
FB_PAGE_ID=
FB_PAGE_TOKEN=
IG_USER_ID=
GALLERY_KEYWORDS=
SOCIAL_SYNC_HOURS=3
